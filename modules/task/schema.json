{
  "properties": {
    "task": {
      "type": "object",
      "required": ["summary", "questions"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["ask", "answer"],
            "additionalProperties": false,
            "properties": {
              "ask": { "type": "string", "minLength": 1 },
              "answer": { "type": "string", "minLength": 1 },
              "detail": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "from": { "type": "string", "minLength": 1 }
            }
          }
        },
        "terms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["term", "means"],
            "additionalProperties": false,
            "properties": {
              "term": { "type": "string", "minLength": 1 },
              "means": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
