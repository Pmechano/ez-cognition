{
  "properties": {
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "term",
          "means"
        ],
        "additionalProperties": false,
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "means": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "link": {
            "type": "string",
            "pattern": "^https?://",
            "patternHint": "must be an http or https URL"
          }
        }
      }
    }
  }
}
