{
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "ask"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,29}$",
            "patternHint": "must be lowercase ASCII letters, digits and '-', at most 30 characters"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "ask": {
            "type": "string",
            "minLength": 1
          },
          "link": {
            "type": "string",
            "pattern": "^(https?://|(?![/.])(?!.*(^|/)\\.)(?!.*\\\\)[^:*?\"<>|]+$)",
            "patternHint": "must be a web address (https://...) or a path in the project, for example docs/task.pdf#page=3"
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
